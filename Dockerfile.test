FROM ubuntu:24.04 AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl openjdk-21-jdk-headless python3 unzip \
    && rm -rf /var/lib/apt/lists/*

ARG GHIDRA_SHA256=b62e81a0390618466c019c60d8c2f796ced2509c4c1aea4a37644a77272cf99d
RUN curl -fsSL -o /tmp/ghidra.zip \
    https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/ghidra_12.1.2_PUBLIC_20260605.zip \
    && echo "$GHIDRA_SHA256  /tmp/ghidra.zip" | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && rm /tmp/ghidra.zip

ENV GHIDRA_INSTALL_DIR=/opt/ghidra_12.1.2_PUBLIC
WORKDIR /src
COPY gradlew ./
COPY gradle/wrapper/ gradle/wrapper/
RUN ./gradlew --version
COPY . .
CMD ["python3", "tests/run_instruction_tests.py"]

FROM base AS test
ARG TEST_RUN=local
RUN printf 'Test run %s\n' "$TEST_RUN" && python3 tests/run_instruction_tests.py

FROM base AS runtime
